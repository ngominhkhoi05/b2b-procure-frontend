# =====================================================
# B2B Procure - Frontend Environment Configuration
# =====================================================
# Copy this file to `.env.development` or `.env.production`
# and fill in real values.
#
# IMPORTANT:
# - Never commit secrets (JWT signing keys, DB credentials,
#   payment gateway keys, etc.) to source control.
# - VITE_* variables are exposed to the browser by design.
# =====================================================

# Spring Boot REST API base URL (must include the version prefix).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Display name used by future layout / title features.
VITE_APP_NAME=B2B Procure

# ── Google OAuth2 ───────────────────────────────────────────────────────────
# The Spring Security default authorization endpoint is exposed at:
#   {backendOrigin}/oauth2/authorization/google
#
# `getOAuth2AuthorizeUrl()` in src/services/authService.js derives that URL
# from VITE_API_BASE_URL automatically, so no additional variable is required
# here. Google Client ID / Secret are configured exclusively on the backend
# via GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET environment variables and must
# NEVER be embedded in frontend code or env files.
#
# Backend env (NOT exposed to the browser):
#   GOOGLE_CLIENT_ID          — OAuth2 client id from Google Cloud Console
#   GOOGLE_CLIENT_SECRET      — OAuth2 client secret (server-side only)
#   OAUTH2_REDIRECT_URI       — must match the registered redirect URI, e.g.
#                               http://localhost:3000/oauth2/redirect

