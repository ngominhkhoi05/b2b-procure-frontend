# =====================================================
# B2B Procure - Frontend Environment Configuration
# =====================================================
# Copy this file to `.env.development` or `.env.production`
# and fill in real values.
#
# IMPORTANT:
# - Never commit secrets (JWT signing keys, DB credentials,
#   payment gateway keys, etc.) to source control.
# - VITE_* variables are exposed to the browser by design.
# =====================================================

# Spring Boot REST API base URL (must include the version prefix).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Display name used by future layout / title features.
VITE_APP_NAME=B2B Procure
